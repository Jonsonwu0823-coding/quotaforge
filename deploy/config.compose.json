    {"alias": "fake-no-usage", "purpose": "chat", "targets": [{"upstream": "qf-fake", "upstream_model": "fake-no-usage", "weight": 1}], "default_max_tokens": 1024},
    {"alias": "fake-slow-5000", "purpose": "chat", "targets": [{"upstream": "qf-fake", "upstream_model": "fake-slow-5000", "weight": 1}], "default_max_tokens": 1024},
