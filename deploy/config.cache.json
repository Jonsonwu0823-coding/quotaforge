{
  "upstreams": [
    {
      "name": "fake-a",
      "base_url": "http://qf-fake-upstream:8081/v1",
      "api_key_env": "QF_FAKE_UPSTREAM_KEY",
      "rpm": 6000,
      "tpm": 100000000
    },
    {
      "name": "fake-b",
      "base_url": "http://qf-fake-upstream-b:8081/v1",
      "api_key_env": "QF_FAKE_UPSTREAM_KEY",
      "rpm": 6000,
      "tpm": 100000000
    }
  ],
  "models": [
    {"alias": "cache-emb", "purpose": "embeddings", "targets": [{"upstream": "fake-a", "upstream_model": "fake-embed", "weight": 1}]},
    {"alias": "cache-emb-b", "purpose": "embeddings", "targets": [{"upstream": "fake-b", "upstream_model": "fake-embed", "weight": 1}]}
  ],
  "database": {"dsn_file": "/run/secrets/app_dsn"},
  "redis": {"url_env": "QF_REDIS_URL"},
  "embedding_cache": {"url_env": "QF_REDIS_CACHE_URL", "ttl_ms": 5000}
}
