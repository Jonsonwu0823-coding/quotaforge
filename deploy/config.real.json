{
  "upstreams": [
    {
      "name": "bailian",
      "base_url_env": "QF_UPSTREAM_BASE_URL",
      "api_key_file": "/run/secrets/upstream_api_key",
      "rpm": 600,
      "tpm": 2000000
    }
  ],
  "models": [
    {"alias": "qwen-plus", "purpose": "chat", "targets": [{"upstream": "bailian", "upstream_model": "qwen-plus", "weight": 1}], "default_max_tokens": 32768},
    {"alias": "text-embedding-v4", "purpose": "embeddings", "targets": [{"upstream": "bailian", "upstream_model": "text-embedding-v4", "weight": 1}]}
  ],
  "database": {"dsn_file": "/run/secrets/app_dsn"},
  "redis": {"url_env": "QF_REDIS_URL"},
  "embedding_cache": {"url_env": "QF_REDIS_CACHE_URL"}
}
